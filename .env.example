# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env จริงเข้า git)

PORT=8787

# Gemini Vision
# ใช้ GEMINI_API_KEY เป็นทางสำรองโดยตรงจาก backend ได้แล้ว
# ไม่ต้องตั้ง Worker ถ้าใช้ Gemini API โดยตรง
GEMINI_API_KEY=REPLACE_WITH_REAL_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional: Gemini Vision proxy เดิม (ถ้ามี สามารถใช้ก่อน direct API)
GEMINI_VISION_PROXY_URL=https://apigemini.katodoohee.workers.dev
GEMINI_WORKER_AUTH_KEY=REPLACE_WITH_REAL_KEY_FROM_OLD_FILE

# DeepSeek proxy (ของเดิม: Cloudflare Worker ที่ kasidathdeepseek.katodoohee.workers.dev)
DEEPSEEK_PROXY_URL=https://kasidathdeepseek.katodoohee.workers.dev
DEEPSEEK_MODEL=deepseek-chat

# ฐานข้อมูล
DATABASE_PATH=./data/wk-health.sqlite
