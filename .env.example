# Copy to .env locally. Never commit real secrets.
PORT=8787

# Frontend origins allowed to call the API
CORS_ORIGINS=https://wk-health-frontend.onrender.com,https://sites.google.com,http://localhost:5173,http://localhost:3000

# Gemini Vision
# Direct API is the primary fallback when the Cloudflare proxy is unavailable.
GEMINI_API_KEY=REPLACE_WITH_REAL_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional Gemini Vision proxy
GEMINI_VISION_PROXY_URL=https://apigemini.katodoohee.workers.dev
GEMINI_WORKER_AUTH_KEY=REPLACE_WITH_REAL_KEY

# DeepSeek proxy
DEEPSEEK_PROXY_URL=https://kasidathdeepseek.katodoohee.workers.dev
DEEPSEEK_MODEL=deepseek-chat

# Database
DATABASE_PATH=./data/wk-health.sqlite

# Web Push — required only for browser push notifications
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com
